# Copy to ~/ai-talent/.env on EC2 (chmod 600) and to .env locally. Never commit real values.
DOMAIN=talent.example.com
ENVIRONMENT=development

# Shared secret API -> AI Engine. Generate with: openssl rand -base64 48
ENGINE_API_KEY=

# Anthropic (LLM + vision OCR)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_VISION_MODEL=

# OpenRouter: embeddings (Nvidia primary, Voyage fallback, 1024 dims) + Jev Decisions API
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDINGS_DIMENSIONS=1024
# OpenRouter slugs (Nvidia primary, Voyage fallback — Voyage is listed as mongodb/voyage-*)
EMBEDDINGS_MODEL=nvidia/nemotron-3.5-embed-1b:free
EMBEDDINGS_MODEL_FALLBACK=mongodb/voyage-4-lite
# Jev fast-pass (evaluate/rank). Bills through OPENROUTER_API_KEY; leave model default unless pinning.
JEV_MODEL_ID=typesafe/jev-1.14
JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
JEV_NOUL_YES=0.80
JEV_NOUL_NO=0.20

# CV storage: Cloudflare R2 (S3 API) or Supabase bucket `cvs`
# STORAGE_BACKEND=auto
STORAGE_BACKEND=auto
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cvs
# Optional; default https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Optional custom domain for signed/public URLs
R2_PUBLIC_BASE_URL=

# .NET binds the same keys as R2__AccountId, R2__AccessKeyId, etc.

# Invite codes: HMAC secret that signs company invite codes (min. 32 bytes). Generate with: openssl rand -base64 48
INVITES__SIGNINGKEY=

# Supabase
SUPABASE_URL=
# Public key used by the API for sign-up (never the service role key).
SUPABASE_ANON_KEY=
# Only the AI Engine uses it (Storage access to CVs). NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Least-privilege DB users (see supabase/migrations/*_security_baseline.sql):
#   ai_talent_api_user    -> member of app_api
#   ai_talent_engine_user -> member of app_engine
API_DB_CONNECTION_STRING=Host=;Port=5432;Database=postgres;Username=ai_talent_api_user;Password=;SSL Mode=Require
ENGINE_DATABASE_URL=postgresql://ai_talent_engine_user:@host:5432/postgres?sslmode=require
