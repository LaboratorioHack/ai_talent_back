# Two sites, one certificate each (Caddy issues them automatically):
#   {$DOMAIN}      -> public landing (Astro, built into the web image under /landing)
#   {$APP_DOMAIN}  -> the app (Next.js) + the API under /api
# Both DNS A records must point to this EC2.

(common) {
	encode zstd gzip

	# OWASP A02/A04: headers common to every response, set once at the edge.
	# CSP and Permissions-Policy are app-specific and set by Next.js (ai_talent_web/next.config.ts).
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
}

{$DOMAIN} {
	import common

	# "/" is the landing page; its assets live under /landing (Astro `base`).
	handle / {
		rewrite * /landing/index.html
		reverse_proxy web:3000
	}

	handle /landing/* {
		reverse_proxy web:3000
	}

	# Anything else belongs to the app: keep path and query (e.g. /login -> app/login).
	handle {
		redir https://{$APP_DOMAIN}{uri} 308
	}
}

{$APP_DOMAIN} {
	import common

	handle /api/* {
		# Bound uploads (CVs <= 10 MiB) before they reach the API.
		request_body {
			max_size 10MB
		}
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
